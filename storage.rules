rules_version = '2';

/**
 * AJ Super Portal — Firebase Storage rules
 * Deploy: Firebase Console → Storage → Rules → paste → Publish
 * Or: firebase deploy --only storage
 *
 * CRITICAL for TikReels: every signed-in user must be able to READ
 * tikreels/** and profile_photos/** so OTHER users' videos play in the feed.
 * <video src="https://firebasestorage..."> does not send Firebase Auth;
 * download URLs with tokens usually work, but public-read on these folders
 * is required when token enforcement / App Check is enabled.
 */
service firebase.storage {
  match /b/{bucket}/o {

    // TikReel / Pulse video objects — public read, owner write
    match /tikreels/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*|image/.*');
    }

    // Profile photos + legacy media uploads (older clients stored clips here)
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 30 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Optional dedicated videos/ prefix
    match /videos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
