# Firebase (client — safe to expose with Authorized Domains configured)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDp2od-lrfAhEHV5oAIqBW5rWjaRbnAdFM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aj-super-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aj-super-portal
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aj-super-portal.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=288191292906
NEXT_PUBLIC_FIREBASE_APP_ID=1:288191292906:web:bc31cb072948533f88fe93
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-8WYD1ZB96D
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://aj-super-portal-default-rtdb.firebaseio.com

# Server-side token verify (defaults to NEXT_PUBLIC_FIREBASE_API_KEY)
FIREBASE_API_KEY=

# Offer Hub — ADGem offerwall + Earn & Play games (Monlix removed)
NEXT_PUBLIC_ADGEM_APP_ID=33088
NEXT_PUBLIC_ADGEM_URL=https://adunits.adgem.com/wall
# AdGem dashboard postback (macros):
# https://aj-portal-one.vercel.app/api/postback?payout={amount}&status={state}&userId={player_id}
# Legacy postback wall (server postback still supported)
NEXT_PUBLIC_OFFERWALL_URL=
# REQUIRED — unsigned postbacks are rejected. Generate with: npm run gen-secrets
OFFERWALL_POSTBACK_SECRET=
AJ_POSTBACK_SECRET=
OFFERWALL_MAX_DAILY=5
OFFERWALL_VIDEO_MAX_DAILY=8
NEXT_PUBLIC_OFFERWALL_VIDEO_MAX_DAILY=8

# Postback URL must include &secret=YOUR_SECRET (same value as OFFERWALL_POSTBACK_SECRET):
# AdGem: https://YOUR_DOMAIN/api/postback?payout={amount}&status={state}&userId={player_id}&secret=YOUR_SECRET
# Credits only when status is lead/success/1/completed. Opening the wall never credits coins.

# Firebase Admin SDK (server-only — NEVER commit real private keys)
# Prefer a single JSON blob in hosting secrets:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"aj-super-portal",...}
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or base64 of the same JSON (avoids Vercel newline escaping issues):
# FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=aj-super-portal
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aj-super-portal.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Measured Adsterra CPC for no-loss Watch Ads guard (must cover 10 coins = $0.01)
# ADSTERRA_REAL_CPC_USD=0.05
# NEXT_PUBLIC_ADSTERRA_CLICK_USD=0.05

# NOWPayments — IPN Secret from NOWPayments dashboard (Settings → Payments)
# Must match Vercel NOWPAYMENTS_IPN_SECRET. Generate optional local key: npm run gen-secrets
# Then paste the SAME value into NOWPayments IPN secret field.
# Callback URL: https://YOUR_DOMAIN/api/nowpayments-callback
NOWPAYMENTS_IPN_SECRET=
# Alias also accepted by /api/callback:
# NOWPAYMENTS_IPN_KEY=

# Monetag (client zone is hardcoded to 11377822; tag URL nap5k.com)
# Rewarded video + interstitial share this zone; see app/lib/ads-config.ts

# Admin One-Click Ban — ONLY these identities see/use the admin panel
NEXT_PUBLIC_ADMIN_EMAIL=ajcreatorstudio.hq@gmail.com
# REQUIRED for owner-share coins to land in your Hub wallet (set your Firebase UID):
# NEXT_PUBLIC_ADMIN_UIDS=yourFirebaseUidHere
# ADMIN_UIDS=yourFirebaseUidHere
# (Also auto-saved when you open Admin Hisaab with Admin SDK configured.)

# Portal APK / PWA install URL shown on Hub → Download App & Earn
NEXT_PUBLIC_APP_APK_URL=/manifest.json

# Web Push (FCM) — public VAPID key
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BMaPMtGtA2VDsj_JH_yv5dOv66Mpguf9v4TkqY96dcs-gwqS-r50IQrJQmZbNkaj-7_iMfBGGN0qc4H0qx4H0qvKg

# Telegram — withdraw alerts to admin (server-only)
TELEGRAM_BOT_TOKEN=8678089315:AAHq1Ta4cYwJVhCag9r9E8qczVXDX_V89KE
TELEGRAM_ADMIN_CHAT_ID=8612011228

# See docs/FIREBASE_AUTH_DOMAINS.md for Google OAuth authorized domains.

