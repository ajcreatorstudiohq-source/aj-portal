# Offer Hub — ADGem offerwall + Earn & Play games (Monlix removed)
NEXT_PUBLIC_ADGEM_APP_ID=33088
NEXT_PUBLIC_ADGEM_URL=https://adunits.adgem.com/wall
# AdGem dashboard postback (macros):
# https://aj-portal-one.vercel.app/api/postback?payout={amount}&status={state}&userId={player_id}
# Legacy postback wall (server postback still supported)
NEXT_PUBLIC_OFFERWALL_URL=
OFFERWALL_POSTBACK_SECRET=AJ_SUPER_SECURE_786_PORTAL
AJ_POSTBACK_SECRET=AJ_SUPER_SECURE_786_PORTAL
# AdGem URL without secret works when this is not "0" (default allow)
OFFERWALL_ALLOW_UNSIGNED_POSTBACK=1
OFFERWALL_MAX_DAILY=5
OFFERWALL_VIDEO_MAX_DAILY=8
NEXT_PUBLIC_OFFERWALL_VIDEO_MAX_DAILY=8

# Postback (profit lock: userReward = floor(payout * 200)):
# AdGem: https://aj-portal-one.vercel.app/api/postback?payout={amount}&status={state}&userId={player_id}
# Generic: https://YOUR_DOMAIN/api/postback?userId={tracking_id}&payout={payout}&txid={offer_id}&status={status}&secret=AJ_SUPER_SECURE_786_PORTAL
# Credits only when status is lead/success/1/completed. Opening the wall never credits coins.

# Firebase Admin SDK (server-only — NEVER commit real private keys)
# Prefer a single JSON blob in hosting secrets:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"aj-super-portal",...}
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or base64 of the same JSON (avoids Vercel newline escaping issues):
# FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=aj-super-portal
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aj-super-portal.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Monetag (client zone is hardcoded to 11377822; tag URL nap5k.com)
# Rewarded video + interstitial share this zone; see app/lib/ads-config.ts

# Admin One-Click Ban — ONLY these identities see/use the admin panel
NEXT_PUBLIC_ADMIN_EMAIL=ajcreatorstudio.hq@gmail.com
# Optional comma-separated Firebase UIDs (in addition to email)
# NEXT_PUBLIC_ADMIN_UIDS=yourFirebaseUidHere
# ADMIN_UIDS=yourFirebaseUidHere

# Portal APK / PWA install URL shown on Hub → Download App & Earn
NEXT_PUBLIC_APP_APK_URL=/manifest.json

