NEXT_PUBLIC_THEOREMREACH_URL=https://theoremreach.com/respondent_entry/direct
# Server-only TheoremReach / offerwall postback secret (dashboard token)
THEOREMREACH_SECRET=f3f1599acbdf40f16cf2eb54a0907306a1f
# REQUIRED — unsigned postbacks are rejected
OFFERWALL_POSTBACK_SECRET=f3f1599acbdf40f16cf2eb54a0907306a1f
AJ_POSTBACK_SECRET=f3f1599acbdf40f16cf2eb54a0907306a1f
OFFERWALL_MAX_DAILY=5
OFFERWALL_VIDEO_MAX_DAILY=8
NEXT_PUBLIC_OFFERWALL_VIDEO_MAX_DAILY=8

# TheoremReach dashboard postback (macros vary — map to these query params):
# https://YOUR_DOMAIN/api/postback?user_id={user_id}&payout={currency_amount}&txid={hash}&secret=YOUR_SECRET&status=completed
# Credits only after verified postback. Opening the survey wall never credits coins.

# Firebase Admin SDK (server-only — NEVER commit real private keys)
# Prefer a single JSON blob in hosting secrets:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"aj-super-portal",...}
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or base64 of the same JSON (avoids Vercel newline escaping issues):
# FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=aj-super-portal
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@aj-super-portal.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Offerwall / TheoremReach postback — SECRET or HMAC sig REQUIRED (unsigned disabled)
# OFFERWALL_POSTBACK_SECRET=f3f1599acbdf40f16cf2eb54a0907306a1f
# THEOREMREACH_SECRET=f3f1599acbdf40f16cf2eb54a0907306a1f
# AJ_POSTBACK_SECRET=f3f1599acbdf40f16cf2eb54a0907306a1f
# Postback URL must include &secret=YOUR_SECRET

# Adsterra — UNIFIED postback for ALL formats (Direct Link · Banner · Video · Native · Social Bar)
# Same 70% Admin / 30% User split — never invent CPC
# https://YOUR_DOMAIN/api/ads/adsterra-postback?user_id={uid}&payout={payout}&txid={clickid}&format={direct_link|banner|video|native_banner|social_bar}&secret=YOUR_SECRET
# ADSTERRA_POSTBACK_SECRET=
# Links open with &psid=aj_{uid}&subid={uid}&aj_fmt={format} for attribution
# Use response=text for plain OK (do not use format=text — format is the ad unit type)

# NOWPayments IPN HMAC header x-nowpayments-sig (required for purchase credits)
# NOWPAYMENTS_IPN_SECRET=

# Monetag (client zone is hardcoded to 11377822; tag URL nap5k.com)
# Rewarded video + interstitial share this zone; see app/lib/ads-config.ts

# Admin One-Click Ban — ONLY these identities see/use the admin panel
NEXT_PUBLIC_ADMIN_EMAIL=ajcreatorstudio.hq@gmail.com
# REQUIRED for owner-share coins to land on CEO Hub wallet (set your Firebase UID):
# Find UID: Firebase Console → Authentication → Users → ajcreatorstudio.hq@gmail.com
NEXT_PUBLIC_ADMIN_UIDS=
ADMIN_UIDS=
# (Also auto-bound when you open Admin panel — /api/admin/bind-owner)

