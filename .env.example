NEXT_PUBLIC_FIREBASE_VAPID_KEY=BMaPMtGtA2VDsj_JH_yv5dOv66Mpguf9v4TkqY96dcs-gwqS-r50IQrJQmZbNkaj-7_iMfBGGN0qc4H0qx4H0qvKg

