rules_version = '2';

/**
 * AJ Super Portal — Firestore rules (social + ads subset)
 * Deploy: Firebase Console → Firestore → Rules → paste/merge → Publish
 *
 * TikReel feed reads `user_posts` + `videos` for ALL creators.
 * Owner-only read on these collections is the #1 reason other users'
 * clips appear as stills / fail to open on profiles.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function postOwner() {
      return request.resource.data.uid == request.auth.uid
          || request.resource.data.userId == request.auth.uid;
    }

    function existingPostOwner() {
      return resource.data.uid == request.auth.uid
          || resource.data.userId == request.auth.uid;
    }

    // Portal CEO — email must match admin Google account
    function isCeoAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'ajcreatorstudio.hq@gmail.com';
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);
      match /videos/{videoId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
      match /followers/{fid} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
      match /following/{fid} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
      // TikTok-style DM inbox / friend ids (both parties may upsert the other's row)
      match /chat_partners/{partnerId} {
        allow read: if isOwner(userId);
        allow create, update: if signedIn()
          && (isOwner(userId) || request.auth.uid == partnerId);
        allow delete: if isOwner(userId);
      }
      match /wechat_contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 1:1 DMs — only the two participants can read/write
    match /chats/{chatId} {
      function chatParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow read: if chatParticipant();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2;
      allow update: if chatParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // Community TikReels — must be readable by every signed-in user
    match /user_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && postOwner();
      allow delete: if signedIn() && existingPostOwner();
      allow update: if signedIn() && existingPostOwner()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likes', 'commentCount', 'views']));
      match /likes/{likerId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == likerId;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /videos/{videoId} {
      allow read: if signedIn();
      allow create: if signedIn() && postOwner();
      allow delete: if signedIn() && existingPostOwner();
      allow update: if signedIn() && existingPostOwner()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likes', 'commentCount', 'views']));
      match /likes/{likerId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == likerId;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /pulse_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && postOwner();
      allow delete: if signedIn() && existingPostOwner();
      allow update: if signedIn() && existingPostOwner()
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likes', 'commentCount', 'views']));
      match /likes/{likerId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == likerId;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // TikTok-style permanent comments (top-level — all signed-in users read/write)
    match /reel_comments/{commentId} {
      // Public read so every viewer sees the same thread (TikTok-style)
      allow read: if true;
      // Keep create rules minimal so writes are not rejected after local optimistic commit
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.text is string;
      allow update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // YouTube / pixa comment parents (optional)
    match /yt_posts/{postId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /ad_reward_sessions/{sessionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /offerwall_ledger/{txId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false; // server / Admin SDK only
    }

    // Live streaming rooms + chat (TikTok-style)
    match /live_rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // PK battles (challenge by user ID / join by pk room ID)
    match /pk_sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.resource.data.hostUid == request.auth.uid
            || request.resource.data.hostId == request.auth.uid);
      allow update: if signedIn();
      allow delete: if signedIn()
        && (resource.data.hostUid == request.auth.uid
            || resource.data.hostId == request.auth.uid);
      match /gifts/{giftId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /notifications/{notifId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }

    // Owner platform share ledger — CEO read; signed-in may append rows
    match /AdminRevenue/{revId} {
      allow read: if isCeoAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Running owner totals (coins + USD) on the portal admin panel
    match /admin_stats/{docId} {
      allow read: if isCeoAdmin();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // Default deny — merge carefully with your existing rules for wallet, admin, etc.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
