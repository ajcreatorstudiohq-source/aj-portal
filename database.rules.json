{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['state', 'uid', 'lastChanged']) && (newData.child('state').val() == 'online' || newData.child('state').val() == 'offline')"
      }
    },

    "ludo": {
      "codes": {
        "$code": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['path', 'created']) && newData.child('path').isString() && newData.child('created').isNumber()"
        }
      },
      "rooms": {
        "$code": {
          ".read": true,
          ".write": true,
          "meta": {
            ".validate": "newData.hasChildren(['hostUid', 'count', 'mode', 'created'])"
          },
          "seats": {
            "$slot": {
              ".validate": "newData.hasChildren(['name', 'avatar', 'uid']) && newData.child('name').isString() && newData.child('avatar').isNumber()"
            }
          },
          "chat": {
            "$msgId": {
              ".validate": "newData.hasChildren(['pIdx', 'msg', 'ts']) && newData.child('msg').isString() && newData.child('msg').val().length <= 80"
            }
          },
          "gameState": {
            ".validate": "newData.hasChildren(['seq', 'turn', 'started'])"
          }
        }
      }
    },

    "live_frames": {
      "$roomId": {
        ".read": true,
        "current": {
          ".write": true
        }
      }
    },

    "live_audio": {
      "$roomId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
