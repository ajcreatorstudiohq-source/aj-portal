{
  "rules": {
    ".read": false,
    ".write": false,

    "ludo": {
      "codes": {
        "$code": {
          ".read": true,
          ".write": true
        }
      },
      "rooms": {
        "$code": {
          ".read": true,
          ".write": true
        }
      }
    },

    "live_frames": {
      "$roomId": {
        ".read": true,
        "current": {
          ".write": true
        }
      }
    },

    "live_audio": {
      "$roomId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
