{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['state', 'uid', 'lastChanged']) && (newData.child('state').val() == 'online' || newData.child('state').val() == 'offline')"
      }
    },

    "ludo": {
      "codes": {
        "$code": {
          ".read": true,
          ".write": true
        }
      },
      "rooms": {
        "$code": {
          ".read": true,
          ".write": true
        }
      }
    },

    "live_frames": {
      "$roomId": {
        ".read": true,
        "current": {
          ".write": true
        }
      }
    },

    "live_audio": {
      "$roomId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
